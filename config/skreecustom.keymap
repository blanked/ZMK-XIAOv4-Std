#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        enable_gaming: enable_gaming {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON &to 3>;
            label = "ENABLE_GAMING";
        };

        disable_gaming: disable_gaming {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_OFF &to 0>;
            label = "DISABLE_GAMING";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC         &kp N1  &kp N2    &kp N3     &kp N4     &kp N5          &kp N6        &kp N7   &kp N8         &kp N9    &kp N0    &kp DELETE
&kp GRAVE       &kp Q   &kp W     &kp E      &kp R      &kp T           &kp Y         &kp U    &kp I          &kp O     &kp P     &kp BACKSLASH
&kp TAB         &kp A   &kp S     &kp D      &kp F      &kp G           &kp H         &kp J    &kp K          &kp L     &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X     &kp C      &kp V      &kp B           &kp N         &kp M    &kp COMMA      &kp DOT   &kp FSLH  &kp RIGHT_SHIFT
                        &kp LEFT  &kp RIGHT                                                    &kp UP         &kp DOWN
                                  &kp LSHFT  &kp SPACE  &kp LCTRL       &kp LEFT_ALT  &kp RET  &kp BACKSPACE
                                             &mo 1      &kp LEFT_ALT    &kp LEFT_WIN  &mo 2
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp F1          &kp F2            &kp F3      &kp F4  &kp F5    &kp F6    &kp F7       &kp F8        &kp F9         &kp F10           &trans
&trans  &trans          &trans            &trans      &trans  &trans    &kp HOME  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &kp MINUS         &kp EQUAL
&trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &trans    &kp END   &kp LEFT     &kp DOWN      &kp RIGHT      &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans  &trans          &trans            &trans      &trans  &trans    &trans    &trans       &trans        &kp F11        &kp F12           &trans
                        &trans            &trans                                               &trans        &trans
                                          &trans      &trans  &trans    &trans    &trans       &trans
                                                      &trans  &trans    &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans       &trans        &trans         &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp HOME  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &kp UNDER       &kp PLUS
&trans  &trans  &trans  &trans  &trans  &trans    &kp END   &kp LEFT     &kp DOWN      &kp RIGHT      &kp LEFT_BRACE  &kp RIGHT_BRACE
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans       &trans        &kp F11        &kp F12         &enable_gaming
                &trans  &trans                                           &trans        &trans
                        &trans  &trans  &trans    &trans    &trans       &trans
                                &trans  &trans    &trans    &trans
            >;
        };

        gaming {
            bindings = <
&trans  &trans          &trans     &trans     &trans        &trans    &trans           &trans           &trans            &trans           &trans  &trans
&kp T   &kp TAB         &kp Q      &kp W      &kp E         &kp R     &rgb_ug RGB_ON   &rgb_ug RGB_OFF  &rgb_ug RGB_BRI   &rgb_ug RGB_BRD  &trans  &trans
&kp G   &kp LEFT_SHIFT  &kp A      &kp S      &kp D         &kp F     &bl BL_ON        &bl BL_OFF       &trans            &trans           &trans  &trans
&kp B   &kp LCTRL       &kp Z      &kp X      &kp C         &kp V     &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_TOG   &trans           &trans  &disable_gaming
                        &kp GRAVE  &mo 1                                                                &disable_gaming   &disable_gaming
                                   &kp SPACE  &kp LCTRL     &mo 1     &trans           &trans           &kp K_PLAY_PAUSE
                                              &kp LEFT_ALT  &trans    &mo 1            &mo 2
            >;
        };
    };
};

