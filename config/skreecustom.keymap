#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC         &kp N1  &kp N2    &kp N3     &kp N4     &kp N5       &kp N6        &kp N7   &kp N8         &kp N9    &kp N0    &kp DELETE
&kp GRAVE       &kp Q   &kp W     &kp E      &kp R      &kp T        &kp Y         &kp U    &kp I          &kp O     &kp P     &kp BACKSLASH
&kp TAB         &kp A   &kp S     &kp D      &kp F      &kp G        &kp H         &kp J    &kp K          &kp L     &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X     &kp C      &kp V      &kp B        &kp N         &kp M    &kp COMMA      &kp DOT   &kp FSLH  &kp RIGHT_SHIFT
                        &kp LEFT  &kp RIGHT                                                 &kp UP         &kp DOWN
                                  &kp LSHFT  &kp SPACE  &kp LCTRL    &kp LEFT_ALT  &kp RET  &kp BACKSPACE
                                             &mo 1      &mo 2        &kp LEFT_WIN  &mo 2
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp F1          &kp F2            &kp F3      &kp F4  &kp F5    &kp F6    &kp F7       &kp F8        &kp F9         &kp F10           &trans
&trans  &trans          &trans            &trans      &trans  &trans    &kp HOME  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &kp MINUS         &kp EQUAL
&trans  &kp K_PREVIOUS  &kp K_PLAY_PAUSE  &kp K_NEXT  &trans  &trans    &kp END   &kp LEFT     &kp DOWN      &kp RIGHT      &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans  &trans          &trans            &trans      &trans  &trans    &trans    &trans       &trans        &kp F11        &kp F12           &trans
                        &trans            &trans                                               &trans        &trans
                                          &trans      &trans  &trans    &trans    &trans       &trans
                                                      &trans  &trans    &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans       &trans        &trans         &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp HOME  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &kp UNDER       &kp PLUS
&trans  &trans  &trans  &trans  &trans  &trans    &kp END   &kp LEFT     &kp DOWN      &kp RIGHT      &kp LEFT_BRACE  &kp RIGHT_BRACE
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans       &trans        &kp F11        &kp F12         &trans
                &trans  &trans                                           &trans        &trans
                        &trans  &trans  &trans    &trans    &trans       &trans
                                &trans  &trans    &trans    &trans
            >;
        };
    };
};

